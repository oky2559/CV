---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/print.css';
import grotesk from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import mono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Terminal from '../components/Terminal.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string;
  noAlternates?: boolean;
}

const { lang, ...seo } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Thème choisi par le visiteur, appliqué avant le premier affichage (pas de flash).
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={grotesk} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={mono} crossorigin />
    <Seo lang={lang} {...seo} />
  </head>
  <body id="top">
    <a class="skip-link" data-no-print href="#main">{t(lang, 'skip')}</a>
    <Nav lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Terminal lang={lang} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--sp-3);
    left: var(--sp-3);
    z-index: calc(var(--z-grain) + 1);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-md);
    background: var(--c-accent);
    color: var(--c-accent-ink);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(calc(-100% - var(--sp-4)));
    transition: transform var(--d-base) var(--ease-out);
  }
  .skip-link:focus {
    transform: none;
  }
  main {
    padding-top: var(--nav-h);
  }
  main:focus {
    outline: none;
  }
</style>
