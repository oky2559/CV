---
import Base from '../../layouts/Base.astro';
import Intro from '../../components/Intro.astro';
import { getCV } from '../../lib/cv';

const lang = 'en';
const cv = getCV(lang);
---
<Base lang={lang} title={`${cv.identity.name} · ${cv.identity.title}`} description={cv.identity.tagline}>
  <Intro lang={lang} cv={cv} />
</Base>
