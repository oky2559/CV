    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{cv.identity.name}</title>
  </head>
  <body>
    <h1>{cv.identity.name}</h1>
    <p>{cv.identity.title}</p>
  </body>
</html>
