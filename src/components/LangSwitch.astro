---
import { homePath, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const target = otherLang(lang);
---
<a
  class="lang-switch"
  href={homePath(target)}
  hreflang={target}
  lang={target}
  data-lang-switch
  aria-label={t(lang, 'lang.switch')}
>
  <span class="current" aria-hidden="true">{lang.toUpperCase()}</span>
  <span class="sep" aria-hidden="true">/</span>
  <span class="target">{t(lang, 'lang.short')}</span>
</a>

<script>
  // Sans JS, le lien mène à l'accueil de l'autre langue.
  // Avec JS, on y ajoute l'ancre de la section actuellement à l'écran.
  function currentSection(): string | null {
    const probe = window.innerHeight * 0.35;
    let current: string | null = null;
    for (const el of document.querySelectorAll<HTMLElement>('main section[id]')) {
      if (el.getBoundingClientRect().top <= probe) current = el.id;
    }
    return current ?? (location.hash.slice(1) || null);
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]')) {
    const base = link.getAttribute('href') ?? '/';
    const update = () => {
      const id = currentSection();
      link.href = id ? `${base}#${id}` : base;
    };
    link.addEventListener('pointerdown', update);
    link.addEventListener('focus', update);
    link.addEventListener('click', update);
  }
</script>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 2.25rem;
    padding: 0 var(--sp-3);
    border: 1px solid var(--c-line);
    border-radius: var(--r-pill);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-decoration: none;
    transition:
      border-color var(--d-fast) ease,
      background-color var(--d-fast) ease,
      color var(--d-fast) ease;
  }
  .current {
    color: var(--c-fg);
  }
  .sep {
    color: var(--c-fg-muted);
  }
  .target {
    color: var(--c-fg-muted);
  }
  .lang-switch:hover,
  .lang-switch:focus-visible {
    border-color: var(--c-accent);
  }
  .lang-switch:hover .target,
  .lang-switch:focus-visible .target {
    color: var(--c-accent);
  }
</style>
