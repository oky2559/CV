---
/**
 * Bloc « Stats GitHub live ». Masqué dans le HTML (`hidden`) : sans JS, ou si
 * l'API ne répond pas correctement, il n'apparaît jamais. `github-ui.ts` le
 * remplit puis l'affiche quand les données sont arrivées.
 */
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  user: string;
}

const { lang, user } = Astro.props;
---
<aside class="gh" aria-labelledby="gh-title" data-gh-stats data-user={user} data-lang={lang} data-no-print hidden>
  <div class="head">
    <h3 id="gh-title" class="eyebrow"><span class="pulse" aria-hidden="true"></span>{t(lang, 'github.title')}</h3>
    <a class="profile mono" href={`https://github.com/${user}`} aria-label={`${t(lang, 'github.profile')} ${user}`}>
      @{user}<span aria-hidden="true"> ↗</span>
    </a>
  </div>
  <dl class="stats">
    <div class="stat">
      <dt class="eyebrow">{t(lang, 'github.repos')}</dt>
      <dd class="num" data-gh-count="repos"></dd>
    </div>
    <div class="stat" data-gh-row="stars" hidden>
      <dt class="eyebrow">{t(lang, 'github.stars')}</dt>
      <dd class="num" data-gh-count="stars"></dd>
    </div>
    <div class="stat" data-gh-row="languages">
      <dt class="eyebrow">{t(lang, 'github.languages')}</dt>
      <dd><ul class="langs" data-gh-languages></ul></dd>
    </div>
    <div class="stat">
      <dt class="eyebrow">{t(lang, 'github.lastPush')}</dt>
      <dd class="when"><time data-gh-last-push></time></dd>
    </div>
  </dl>
</aside>

<script>
  import '../scripts/github-ui';
</script>

<style>
  .gh {
    margin-top: var(--sp-8);
    padding: var(--sp-5);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-bg-raised);
    transition:
      opacity var(--d-slow) var(--ease-out),
      translate var(--d-slow) var(--ease-out);
  }
  .gh[hidden],
  .stat[hidden] {
    display: none;
  }
  /* Entrée en fondu une fois les données arrivées (durée nulle en reduced-motion). */
  .gh.is-entering {
    opacity: 0;
    translate: 0 1rem;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-4);
    margin-bottom: var(--sp-5);
  }
  h3 {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 0 var(--c-accent);
    animation: pulse 2s var(--ease-out) infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 0.5rem rgb(198 255 61 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(198 255 61 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
  .profile {
    font-size: var(--fs-sm);
    color: var(--c-fg-muted);
    text-decoration: none;
  }
  .profile:hover,
  .profile:focus-visible {
    color: var(--c-accent);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--sp-5) var(--sp-6);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-width: 0;
  }
  .num {
    font-size: var(--fs-3xl);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--c-accent);
    font-variant-numeric: tabular-nums;
  }
  .langs {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .langs :global(li) {
    padding: var(--sp-1) var(--sp-3);
    border: 1px solid var(--c-line);
    border-radius: var(--r-pill);
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
  }
  .when {
    font-size: var(--fs-lg);
    font-weight: 600;
  }
</style>
