---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<button
  class="theme-toggle"
  type="button"
  hidden
  data-theme-toggle
  data-label-light={t(lang, 'theme.toLight')}
  data-label-dark={t(lang, 'theme.toDark')}
  aria-label={t(lang, 'theme.toLight')}
>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" fill="currentColor" />
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </g>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" />
  </svg>
</button>

<script>
  // Sans JS le bouton reste masqué : le thème suit alors le réglage du système.
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const systemLight = window.matchMedia('(prefers-color-scheme: light)');

  const current = (): 'light' | 'dark' =>
    root.dataset.theme === 'light' || root.dataset.theme === 'dark'
      ? root.dataset.theme
      : systemLight.matches
        ? 'light'
        : 'dark';

  function render(): void {
    if (!button) return;
    const isLight = current() === 'light';
    button.setAttribute('aria-label', (isLight ? button.dataset.labelDark : button.dataset.labelLight) ?? '');
    button.dataset.current = current();
  }

  if (button) {
    button.hidden = false;
    render();
    systemLight.addEventListener('change', render);
    button.addEventListener('click', () => {
      const next = current() === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* stockage indisponible : le choix vaut pour cette page seulement */
      }
      render();
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--c-line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--c-fg);
    cursor: pointer;
    transition:
      border-color var(--d-fast) ease,
      color var(--d-fast) ease;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }
  .theme-toggle > svg {
    grid-area: 1 / 1;
  }
  /* On montre l'icône du thème vers lequel on bascule. */
  .theme-toggle[data-current='dark'] .moon,
  .theme-toggle[data-current='light'] .sun,
  .theme-toggle:not([data-current]) .moon {
    display: none;
  }
</style>
